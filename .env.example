# Cliente (Vite embute no bundle — nunca coloque segredo aqui)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# URL canônica do app (links de convite). Em produção use o domínio final.
VITE_APP_URL=http://localhost:8080
APP_BASE_URL=http://localhost:8080

# Servidor (nunca prefixar com VITE_)
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=

# Cron de retenção LGPD (Vercel envia Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# Opcional — e-mails (convites e lembretes)
RESEND_API_KEY=
REMINDER_FROM_EMAIL=Zēllu <noreply@zellu.app>
# INVITE_FROM_EMAIL=  # opcional; usa REMINDER_FROM_EMAIL se omitido
# Caixa que recebe pedidos de teste da landing (RH)
# LEADS_TO_EMAIL=ola@zellu.app
