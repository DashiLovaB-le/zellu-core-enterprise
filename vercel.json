{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/jobs/retention",
      "schedule": "15 9 * * *"
    },
    {
      "path": "/api/jobs/monthly-report",
      "schedule": "0 12 1 * *"
    }
  ]
}
